#!/bin/bash
# =============================================================================
# Pituitary nnU-Net — Custom Trainer + 5-Fold + Ensemble
# =============================================================================

set -e

# ── ENV VARS ─────────────────────────────────────────────────────────────────
export nnUNet_raw=/home/23bq1a4293/Personal/project/nnunet/nnUNet_raw
export nnUNet_preprocessed=/home/23bq1a4293/Personal/project/nnunet/nnUNet_preprocessed
export nnUNet_results=/home/23bq1a4293/Personal/project/nnunet/nnUNet_results
export nnUNet_compile=0

CONDA_PYTHON=/home/23bq1a4293/.conda/envs/nnunet_env/bin/python
CONDA_BIN=/home/23bq1a4293/.conda/envs/nnunet_env/bin

# ── YOUR TRAINER FILE ────────────────────────────────────────────────────────
TRAINER_SRC=/home/23bq1a4293/Personal/project/IMAGE_SEGMENTATION/pit/train_nnunet.py
TRAINER_DST=/home/23bq1a4293/.conda/envs/nnunet_env/lib/python3.11/site-packages/nnunetv2/training/nnUNetTrainer/nnUNetTrainerPituitary.py

DATASET_ID=1
CONFIG=2d
TRAINER=nnUNetTrainerPituitary
LOGDIR=/home/23bq1a4293/Personal/project/nnunet/logs
LOG=/home/23bq1a4293/Personal/project/IMAGE_SEGMENTATION/pit/nnunet_v2_master.log

mkdir -p $LOGDIR

echo "=============================================" | tee $LOG
echo "nnU-Net Pituitary V2 Launch" | tee -a $LOG
echo "$(date)" | tee -a $LOG
echo "=============================================" | tee -a $LOG

# ── STEP 1: INSTALL CUSTOM TRAINER ───────────────────────────────────────────
echo "" | tee -a $LOG
echo "STEP 1: Installing custom trainer..." | tee -a $LOG

cp $TRAINER_SRC $TRAINER_DST
cp $TRAINER_SRC /home/23bq1a4293/.local/lib/python3.11/site-packages/nnunetv2/training/nnUNetTrainer/nnUNetTrainerPituitary.py
echo "✅ Trainer copied to: $TRAINER_DST" | tee -a $LOG

$CONDA_PYTHON -c "
from nnunetv2.training.nnUNetTrainer.nnUNetTrainerPituitary import nnUNetTrainerPituitary
print('✅ Trainer import OK')
" 2>&1 | tee -a $LOG

# ── STEP 2: FIX FFT_CONV IN BOTH .local AND CONDA ────────────────────────────
echo "" | tee -a $LOG
echo "STEP 2: Patching fft_conv in all locations..." | tee -a $LOG

$CONDA_PYTHON << 'EOF'
import glob

search_paths = [
    '/home/23bq1a4293/.local/lib/python3.11/site-packages/batchgeneratorsv2/**/*.py',
    '/home/23bq1a4293/.conda/envs/nnunet_env/lib/python3.11/site-packages/batchgeneratorsv2/**/*.py',
]

patched = []
for pattern in search_paths:
    for f in glob.glob(pattern, recursive=True):
        try:
            with open(f, 'r') as fp:
                content = fp.read()
            changed = False
            if 'from fft_conv_pytorch import fft_conv' in content and \
               '# from fft_conv_pytorch import fft_conv  # disabled' not in content:
                content = content.replace(
                    'from fft_conv_pytorch import fft_conv',
                    '# from fft_conv_pytorch import fft_conv  # disabled'
                )
                changed = True
            if 'force_use_fft=True' in content:
                content = content.replace(
                    'blur_dimension(dummy_img, sigma, dim_to_blur, force_use_fft=True)',
                    'blur_dimension(dummy_img, sigma, dim_to_blur, force_use_fft=False)'
                )
                changed = True
            if 'if not force_use_fft else fft_conv' in content:
                content = content.replace(
                    'conv_op = conv_ops[spatial_dims] if not force_use_fft else fft_conv',
                    'conv_op = conv_ops[spatial_dims]  # fft_conv disabled'
                )
                changed = True
            if changed:
                with open(f, 'w') as fp:
                    fp.write(content)
                patched.append(f)
        except Exception as e:
            print(f"Skip {f}: {e}")

if patched:
    print(f"Patched {len(patched)} files:")
    for f in patched:
        print(f"  {f}")
else:
    print("✅ All files already patched")
EOF
echo "✅ fft_conv patch done" | tee -a $LOG

# ── STEP 3: PREPROCESS ───────────────────────────────────────────────────────
echo "" | tee -a $LOG
echo "STEP 3: Checking preprocessing..." | tee -a $LOG

if [ -d "$nnUNet_preprocessed/Dataset001_Pituitary/nnUNetPlans_2d" ]; then
    echo "✅ Already preprocessed — skipping" | tee -a $LOG
else
    echo "Running plan & preprocess..." | tee -a $LOG
    $CONDA_BIN/nnUNetv2_plan_and_preprocess \
        -d $DATASET_ID \
        --verify_dataset_integrity \
        -c $CONFIG \
        2>&1 | tee -a $LOG
    echo "✅ Preprocessing done" | tee -a $LOG
fi

# ── STEP 4: TRAIN ALL 5 FOLDS ────────────────────────────────────────────────
echo "" | tee -a $LOG
echo "STEP 4: Training all 5 folds..." | tee -a $LOG
echo "  Each fold: 1500 epochs | Total: ~10-15 hours" | tee -a $LOG

for FOLD in 0 1 2 3 4; do
    echo "" | tee -a $LOG
    echo "─────────────────────────────────────" | tee -a $LOG
    echo "Starting FOLD $FOLD — $(date)" | tee -a $LOG
    echo "─────────────────────────────────────" | tee -a $LOG

    CUDA_VISIBLE_DEVICES=0 $CONDA_BIN/nnUNetv2_train \
        $DATASET_ID $CONFIG $FOLD \
        --npz \
        -tr $TRAINER \
        2>&1 | tee $LOGDIR/fold${FOLD}.log

    echo "✅ Fold $FOLD complete — $(date)" | tee -a $LOG
done

echo "" | tee -a $LOG
echo "=============================================" | tee -a $LOG
echo "ALL 5 FOLDS COMPLETE — $(date)" | tee -a $LOG
echo "=============================================" | tee -a $LOG

# ── STEP 5: FIND BEST CONFIGURATION ──────────────────────────────────────────
echo "" | tee -a $LOG
echo "STEP 5: Finding best postprocessing config..." | tee -a $LOG

$CONDA_BIN/nnUNetv2_find_best_configuration \
    $DATASET_ID \
    -c $CONFIG \
    -tr $TRAINER \
    2>&1 | tee -a $LOG || echo "⚠️  find_best_configuration failed — continuing" | tee -a $LOG

# ── STEP 6: ENSEMBLE INFERENCE ───────────────────────────────────────────────
echo "" | tee -a $LOG
echo "STEP 6: Running ensemble inference..." | tee -a $LOG

PRED_DIR=/home/23bq1a4293/Personal/project/nnunet/predictions_v2_ensemble
IMG_DIR=$nnUNet_raw/Dataset001_Pituitary/imagesTr
mkdir -p $PRED_DIR

$CONDA_BIN/nnUNetv2_predict \
    -i $IMG_DIR \
    -o $PRED_DIR \
    -d $DATASET_ID \
    -c $CONFIG \
    -tr $TRAINER \
    -f 0 1 2 3 4 \
    --save_probabilities \
    2>&1 | tee -a $LOG

echo "✅ Predictions saved to: $PRED_DIR" | tee -a $LOG

# ── STEP 7: COMPUTE FINAL DICE ───────────────────────────────────────────────
echo "" | tee -a $LOG
echo "STEP 7: Computing final Dice scores..." | tee -a $LOG

$CONDA_PYTHON << 'PYEOF'
import os
import numpy as np
import nibabel as nib
from pathlib import Path

pred_dir  = Path("/home/23bq1a4293/Personal/project/nnunet/predictions_v2_ensemble")
label_dir = Path("/home/23bq1a4293/Personal/project/nnunet/nnUNet_raw/Dataset001_Pituitary/labelsTr")

LABEL_NAMES = ["tumor", "gland", "ICA-L", "ICA-R", "chiasm"]

def dice(pred, gt, cls):
    p = (pred == cls).astype(float)
    g = (gt   == cls).astype(float)
    denom = p.sum() + g.sum()
    return 2 * (p * g).sum() / denom if denom > 0 else float('nan')

pred_files = sorted(pred_dir.glob("*.nii.gz"))
if not pred_files:
    print("No prediction files found")
    exit()

all_dices = []
print(f"\n{'PID':<25} {'Tumor':>7} {'Gland':>7} {'ICA-L':>7} {'ICA-R':>7} {'Chiasm':>7} {'Mean':>7}")
print("-"*72)

for pred_path in pred_files:
    pid     = pred_path.stem.replace(".nii", "")
    gt_path = label_dir / pred_path.name
    if not gt_path.exists():
        continue
    pred_arr = nib.load(pred_path).get_fdata().astype(np.uint8)
    gt_arr   = nib.load(gt_path).get_fdata().astype(np.uint8)
    row  = [dice(pred_arr, gt_arr, cls) for cls in range(1, 6)]
    all_dices.append(row)
    vals = "  ".join(f"{v:7.3f}" if not np.isnan(v) else "    nan" for v in row)
    print(f"{pid:<25} {vals}  {np.nanmean(row):7.3f}")

if all_dices:
    arr   = np.array(all_dices)
    means = np.nanmean(arr, axis=0)
    stds  = np.nanstd(arr,  axis=0)
    print("-"*72)
    print("Mean                     " + "  ".join(f"{m:7.3f}" for m in means) +
          f"  {np.nanmean(means):7.3f}")
    print("Std                      " + "  ".join(f"{s:7.3f}" for s in stds))

    print("\n" + "="*55)
    print("COMPARISON vs previous best (nnU-Net fold0 only)")
    print("="*55)
    prev = {"tumor":0.908, "gland":0.390, "ICA-L":0.748,
            "ICA-R":0.753, "chiasm":0.531, "mean":0.659}
    for i, name in enumerate(LABEL_NAMES):
        delta = means[i] - prev[name]
        arrow = "✅" if delta > 0 else "❌"
        print(f"  {name:<10}: {prev[name]:.3f} → {means[i]:.3f}  ({delta:+.3f}) {arrow}")
    overall = float(np.nanmean(means))
    print(f"  {'mean':<10}: {prev['mean']:.3f} → {overall:.3f}  ({overall-prev['mean']:+.3f})")
PYEOF

echo "" | tee -a $LOG
echo "✅ All done! Log: $LOG" | tee -a $LOG